{
  "name": "turingpot",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./.turingpot/public"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "build": {
    "command": "npm run build",
    "watch_dir": ["default.json", "templates", "scripts", "src"]
  }
}
